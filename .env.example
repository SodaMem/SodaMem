# Copy this file to `.env` and fill it in, then `docker compose up -d`.
# Every var here maps 1:1 to server/settings.py (SODAMEM_ prefix, pydantic-settings).

# --- auth --------------------------------------------------------------
# REQUIRED. Shared secret callers send as `Authorization: Bearer <key>` or
# `X-API-Key: <key>`. The server refuses to start without this unless
# SODAMEM_AUTH_DISABLED=true (see below) — there is no silently-open default.
SODAMEM_API_KEY=

# Local-dev-only escape hatch. Leave unset/false for anything reachable off
# your own machine. docker-compose.yml deliberately does not set this for
# you — turning auth off is an explicit, per-deployment choice.
# SODAMEM_AUTH_DISABLED=false

# --- storage -------------------------------------------------------------
# Fixed to /data by docker-compose.yml (matches the named volume mount) —
# do not set this here, it will be ignored under compose. Listed for
# reference when running the image directly with `docker run` instead.
# SODAMEM_DATA_ROOT=/data

# LRU cap on concurrently-open per-user stores. Raise if you expect more
# than 64 distinct users hitting the server concurrently.
# SODAMEM_STORE_CACHE_MAX=64

# Allow DELETE /v1/memories/{id}?purge=true to PHYSICALLY erase a memory and
# cascade to its roles, edges and vectors. Off by default: an ordinary DELETE
# archives (the memory leaves search/context, the record and its provenance
# stay). Turn this on only if you need right-to-erasure deletes — it is
# irreversible and it breaks the provenance of any answer that cited the fact.
# SODAMEM_ALLOW_PURGE=false

# --- control plane (ADR 0001) ----------------------------------------------
# Operational state — async job status, named API keys, request log — lives in
# a separate SQLite database at <data_root>/.control/sodamem_control.db, so
# deleting a user's memories never takes the operator's job history with it.
#
# Rolling cap on the persisted request log, enforced in the same transaction
# as each insert. Set to 0 to turn the log off entirely (a real off switch,
# not a very small cap).
# SODAMEM_REQUEST_LOG_MAX=10000
#
# Rolling cap on persisted async job records. Oldest pruned first, so a job
# you just submitted is never the one dropped.
# SODAMEM_JOB_RETENTION_MAX=5000
#
# There is no worker-count knob: one worker is a correctness constraint, not
# a tuning parameter (per-user SQLite without WAL). The server takes an
# exclusive lock on its data root and a second process refuses to start.

# --- llm (needed for ingest extraction and POST /v1/answer) ----------------
# NOT needed by /v1/search or /v1/context: those are the zero-LLM tier and
# work with everything below unset. The same four names are what the library
# reads too (sodamem.llm.create_provider_from_env), so an embedded process and
# this container are configured identically.
# One of: openai | anthropic | deepseek | gemini
SODAMEM_LLM_PROVIDER=openai
SODAMEM_LLM_MODEL=
SODAMEM_LLM_API_KEY=
# Only needed for an OpenAI-compatible endpoint that isn't api.openai.com
# (self-hosted gateways, DeepSeek, Gemini's OpenAI-compat surface, etc.)
# SODAMEM_LLM_BASE_URL=

# --- server ----------------------------------------------------------------
# Host port is set in docker-compose.yml's `ports:` mapping, not here — see
# that file's comment if you need something other than 8000 on the host side.
# SODAMEM_PORT=8000

# JSON array of exact origins for CORS (pydantic-settings parses list fields
# as JSON, not a comma list). Leave unset (no browser callers) or name them
# explicitly — never "*" once auth is on.
# SODAMEM_CORS_ORIGINS=["https://your-app.example.com"]
